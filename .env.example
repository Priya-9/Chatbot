# Copy to .env and fill in. Every setting is documented in app/config.py.

# --- General ---
BUSINESS_NAME=Acme Cloud
ENVIRONMENT=development            # production enables strict checks (secrets, signature, SMTP)
LOG_LEVEL=INFO

# --- WhatsApp Business Cloud API (Meta for Developers → your app → WhatsApp → API Setup) ---
WHATSAPP_TOKEN=                    # permanent System User token in production
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me-verify-token
WHATSAPP_APP_SECRET=            # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_API_VERSION=v26.0

# --- LLM ---
LLM_PROVIDER=groq                  # groq | claude

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Claude (https://console.anthropic.com), used when LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low                     # low = fastest replies; raise to medium/high for harder questions (both providers)
LLM_MAX_TOKENS=4096
LLM_FALLBACKS=true                 # Claude only: server-side refusal fallback (set false on Bedrock/Vertex/Foundry)
LLM_HISTORY_TURNS=10

# --- RAG ---
KNOWLEDGE_DIR=knowledge
RAG_REINDEX_ON_STARTUP=false        # true -> re-read KNOWLEDGE_DIR on every start
RAG_BACKEND=bm25                   # bm25 | chroma (pip install chromadb)
RAG_TOP_K=4

# --- Database ---
DATABASE_URL=sqlite:///./data/app.db
# DATABASE_URL=postgresql+psycopg://bot:bot@localhost:5432/bot

# --- CRM ---
CRM_PROVIDER=local                 # local | hubspot | webhook
HUBSPOT_ACCESS_TOKEN=              # HubSpot private app token (crm.objects.contacts.read/write)
CRM_WEBHOOK_URL=                   # Zapier / Make / n8n / custom endpoint
CRM_WEBHOOK_SECRET=                # optional HMAC signing secret (X-Signature-256 header)

# --- End-user OTP authentication ---
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
SESSION_TTL_HOURS=24
SMTP_HOST=                         # empty in development → codes are printed to the log
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Admin API ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string

# --- Languages ---
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,hi,ar    # each needs locales/<code>.yaml

# --- Per-client files (client deployments mount their own copies; see deploy/README.md) ---
LOCALES_DIR=locales
JOURNEY_FILE=app/journeys/flows/main.yaml
SYSTEM_PROMPT_FILE=prompts/system_prompt.md   # AI tone and rules; {business} -> BUSINESS_NAME
