# Settings for ONE client. new-client.sh fills the __PLACEHOLDERS__ and generates the secrets.
# Every app setting is documented in app/config.py. Keep this file private (chmod 600).

# --- Deployment (used by docker compose and the deploy scripts) ---
CLIENT_ID=__CLIENT_ID__
CLIENT_DOMAIN=__CLIENT_DOMAIN__
IMAGE_TAG=latest                     # pin a version (e.g. 20261006-ab12cd3) to roll out updates client by client
DB_PASSWORD=__DB_PASSWORD__

# --- Branding ---
BUSINESS_NAME=__BUSINESS_NAME__
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi            # each needs locales/<code>.yaml in this folder

# --- WhatsApp Cloud API (client's own Meta app; see docs/client-onboarding.md) ---
WHATSAPP_TOKEN=                      # System User token, expiry "Never"
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                 # App settings → Basic → App secret
WHATSAPP_VERIFY_TOKEN=__VERIFY_TOKEN__   # paste into Meta → WhatsApp → Configuration → Webhook
WHATSAPP_API_VERSION=v26.0

# --- AI (client's own key, or yours billed back) ---
LLM_PROVIDER=groq                    # groq (cheapest) | claude (best quality)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5            # claude-sonnet-5-5 costs about half per token
LLM_EFFORT=low

# --- CRM: local | hubspot | webhook ---
CRM_PROVIDER=local
HUBSPOT_ACCESS_TOKEN=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Admin API (give these to the client's staff for human handoff) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASSWORD__
JWT_SECRET=__JWT_SECRET__

# SMTP comes from /opt/bots/shared.env; set SMTP_* here only to override it for this client.
