# Server-wide settings shared by every client. setup-server.sh copies this to /opt/bots/shared.env.
# Each client's own .env is loaded after this file, so a client can override any value here.

# --- Used by the deploy scripts and Caddy (not by the app) ---
BOT_DOMAIN=bot.yourdomain.com        # clients get <client-id>.bot.yourdomain.com (needs DNS: A  *.bot  -> VPS IP)
ACME_EMAIL=you@example.com           # Let's Encrypt expiry notices
BACKUP_KEEP_DAYS=14
RCLONE_REMOTE=                       # optional off-server copy, e.g. b2:my-bot-backups (run `rclone config` first)

# --- App settings shared by all clients (OTP emails) ---
# Brevo free tier: smtp-relay.brevo.com, port 587, login + SMTP key from Brevo → SMTP & API
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
