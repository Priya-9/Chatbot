# Sales-demo mode: add these to .env (on top of your normal keys) to run the niche demo on WhatsApp.
# Try it locally first:  python scripts/chat_cli.py --demo

BUSINESS_NAME=Your Brand Name          # YOUR freelance brand: shown as "built by ..." and in the pitch
NICHES_FILE=demo/niches.yaml           # niche list, sample businesses, booking wording
KNOWLEDGE_DIR=demo/knowledge           # one sub-folder per niche
JOURNEY_FILE=app/journeys/flows/demo.yaml
SYSTEM_PROMPT_FILE=demo/system_prompt.md
RAG_REINDEX_ON_STARTUP=true            # re-read demo/knowledge on every start
SUPPORTED_LANGUAGES=en,hi,es,ar

# Send demo bookings and "get this bot" leads to a Google Sheet via Zapier / Make / n8n:
# CRM_PROVIDER=webhook
# CRM_WEBHOOK_URL=https://hooks.zapier.com/...
